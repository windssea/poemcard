 "stanzas":[{"id":"s1","lines":[{"id":"l1","text":"荷尽已无擎雨盖，"},{"id":"l2","text":"菊残犹有傲霜枝。"},{"id":"l3","text":"一年好景君须记，"},{"id":"l4","text":"最是橙黄橘绿时。"}]}],
 "famousLines":[{"id":"q1","lineIds":["l3","l4"],"text":"一年好景君须记，最是橙黄橘绿时。"}],
 "annotations":[{"id":"a1","term":"擎雨盖","text":"像雨伞般向上托起的荷叶。","lineIds":["l1"]},{"id":"a2","term":"傲霜","text":"不畏霜寒，借以表现坚韧。","lineIds":["l2"]},{"id":"a3","term":"刘景文","text":"刘季孙，字景文，是苏轼在杭州的友人。","lineIds":[]}],
