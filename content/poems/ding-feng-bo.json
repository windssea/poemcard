 "preface":"三月七日，沙湖道中遇雨，雨具先去，同行皆狼狈，余独不觉。已而遂晴，故作此词。",
 "stanzas":[
  {"id":"s1","lines":[{"id":"l1","text":"莫听穿林打叶声，"},{"id":"l2","text":"何妨吟啸且徐行。"},{"id":"l3","text":"竹杖芒鞋轻胜马，"},{"id":"l4","text":"谁怕？"},{"id":"l5","text":"一蓑烟雨任平生。"}]},
  {"id":"s2","lines":[{"id":"l6","text":"料峭春风吹酒醒，"},{"id":"l7","text":"微冷，"},{"id":"l8","text":"山头斜照却相迎。"},{"id":"l9","text":"回首向来萧瑟处，"},{"id":"l10","text":"归去，"},{"id":"l11","text":"也无风雨也无晴。"}]}
 ],
